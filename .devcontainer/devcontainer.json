{
  "name": "neovim-devcontainer",
  "image": "mcr.microsoft.com/devcontainers/rust:1",
  "features": {
    // ランチャーやプラグインが作る兄弟コンテナを、ホストの Docker を汚さずに試すため。
    // コンテナ内のパスとデーモンから見たパスが一致するので、bind mount の検証も素直にできる。
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    // devcontainer CLI(@devcontainers/cli)の実行に使う。
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    // GitHub Actions の実行状況の確認などに使う。
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // 下の bind mount は、マウント元がホストにないとコンテナが起動しない。
  // ホストで Claude Code を使ったことがない場合に備えて、空の状態で作っておく。
  "initializeCommand": "mkdir -p \"$HOME/.claude\" && { [ -e \"$HOME/.claude.json\" ] || echo '{}' > \"$HOME/.claude.json\"; }",
  "mounts": [
    // Claude Code の認証情報と設定をホストと共有する。トークン更新も双方に反映される。
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
    // ~/.claude.json は書き込みのたびに置き換えられるので、ファイル単体では bind mount しない。
    // 読み取り専用で置いておき、post-create でコピーする。
    "source=${localEnv:HOME}/.claude.json,target=/mnt/host-claude.json,type=bind,readonly",
    // gh の認証情報。コンテナを作り直しても `gh auth login` をやり直さずに済むように volume に置く。
    "source=neovim-devcontainer-gh-${devcontainerId},target=/home/vscode/.config/gh,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "sumneko.lua",
        "JohnnyMorganz.stylua",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
